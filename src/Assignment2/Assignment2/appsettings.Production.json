{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    //"Redis": "localhost:6379,password=MyRedisPass123,allowAdmin=true,abortConnect=false",
    "Redis": "localhost:6379,user=borhan,password=MyRedisPass123,ssl=false,allowAdmin=true,abortConnect=false,connectTimeout=500"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MongoDB" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MongoDB",
        "Args": {
          "databaseUrl": "mongodb://borhan:MyMongoPass123@localhost:27017/ProductManagementDb?authSource=ProductManagementDb",
          "collectionName": "Logs",
          "cappedMaxSizeMb": 256,
          "cappedMaxDocuments": 10000
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "AssignmentProjectAPI"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://borhan:MyMongoPass123@localhost:27017",
    "DatabaseName": "ProductManagementDb"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "AssignmentProjectAPI",
    "Audience": "AssignmentProjectClient",
    "ExpirationMinutes": 60
  }
}
